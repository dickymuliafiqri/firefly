# ==============================================================================
# React (Vite + TypeScript) Frontend .gitignore
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Production build output (retain .gitkeep for Go embedFS compilation)
dist/*
!dist/.gitkeep

# Vite and compiler caches
.vite/
*.tsbuildinfo

# Environment variables & local credentials
.env
.env.*
!.env.example
.env.local
.env.development.local
.env.test.local
.env.production.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Editor & OS files
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Hidden dot-directories
.*/
!.gitkeep

